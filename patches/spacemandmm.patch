From 34f4d554fa1cc889529b3bea6d75261a9fee8ad6 Mon Sep 17 00:00:00 2001
From: "Sophie Wallace (Cloub)" <sophie@wiox.me>
Date: Sun, 8 Nov 2026 17:15:08 +0000
Subject: [PATCH 13/13] Preprocessor: __LINE__ in a macro body counts the line
 breaks inside the arguments before it

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 crates/dreammaker/src/preprocessor.rs | 26 +++++++++++++++++++++++++-
 1 file changed, 25 insertions(+), 1 deletion(-)

diff --git a/crates/dreammaker/src/preprocessor.rs b/crates/dreammaker/src/preprocessor.rs
index 8ce0541..6030434 100644
--- a/crates/dreammaker/src/preprocessor.rs
+++ b/crates/dreammaker/src/preprocessor.rs
@@ -1272,6 +1272,25 @@ impl<'ctx> Preprocessor<'ctx> {
                             return Err(self.error("wrong number of arguments to macro call"));
                         }
 
+                        // DreamMaker rescans the expansion as text, so a `__LINE__` in the
+                        // body is the line of the `)` plus the line breaks inside the
+                        // arguments pasted before it (not those around an argument)
+                        let arg_breaks: Vec<u32> = args
+                            .iter()
+                            .map(|arg| {
+                                let start = arg.iter().position(|t| *t != Token!['\n']);
+                                let end = arg.iter().rposition(|t| *t != Token!['\n']);
+                                match (start, end) {
+                                    (Some(start), Some(end)) => arg[start..=end]
+                                        .iter()
+                                        .filter(|t| **t == Token!['\n'])
+                                        .count() as u32,
+                                    _ => 0,
+                                }
+                            })
+                            .collect();
+                        let mut breaks = 0;
+
                         // paste them into the expansion
                         let mut expansion = VecDeque::new();
                         let mut input = subst.iter().cloned();
@@ -1280,7 +1299,12 @@ impl<'ctx> Preprocessor<'ctx> {
                                 // just an ident = expand it
                                 Token::Ident(ident, ws) => {
                                     match params.iter().position(|x| *x == ident) {
-                                        Some(i) => expansion.extend(args[i].iter().cloned()),
+                                        Some(i) => {
+                                            breaks += arg_breaks[i];
+                                            expansion.extend(args[i].iter().cloned())
+                                        },
+                                        None if ident == ident!("__LINE__") && breaks > 0 => expansion
+                                            .push_back(Token::Int((self.last_input_loc.line + breaks) as i32)),
                                         None => expansion.push_back(Token::Ident(ident, ws)),
                                     }
                                 },
