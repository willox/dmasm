Subject: [PATCH 11/13] Parameter: remember a leading slash (BYOND doesn't
 declare such a parameter)

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 crates/dreammaker/src/ast.rs     | 3 +++
 crates/dreammaker/src/objtree.rs | 1 +
 crates/dreammaker/src/parser.rs  | 4 +++-
 3 files changed, 7 insertions(+), 1 deletion(-)

diff --git a/crates/dreammaker/src/ast.rs b/crates/dreammaker/src/ast.rs
index 702617a..48f77ef 100644
--- a/crates/dreammaker/src/ast.rs
+++ b/crates/dreammaker/src/ast.rs
@@ -1443,6 +1443,9 @@ pub struct Parameter {
     pub default: Option<Expression>,
     pub in_list: Option<Expression>,
     pub location: Location,
+    /// Written with a leading slash (`/obj/x`), which BYOND doesn't take as a
+    /// parameter at all.
+    pub absolute: bool,
 }
 
 impl fmt::Display for Parameter {
diff --git a/crates/dreammaker/src/objtree.rs b/crates/dreammaker/src/objtree.rs
index 5ce20b0..7ef69e2 100644
--- a/crates/dreammaker/src/objtree.rs
+++ b/crates/dreammaker/src/objtree.rs
@@ -1359,6 +1359,7 @@ impl ObjectTreeBuilder {
                 default: None,
                 in_list: None,
                 location: Location::BUILTINS,
+                absolute: false,
             })
             .collect();
         let (parent, mut proc_name) = self.get_from_path(location, &mut path, len).unwrap();
diff --git a/crates/dreammaker/src/parser.rs b/crates/dreammaker/src/parser.rs
index 99d80e1..4044d00 100644
--- a/crates/dreammaker/src/parser.rs
+++ b/crates/dreammaker/src/parser.rs
@@ -1346,12 +1346,13 @@ impl<'ctx, 'an, 'inp> Parser<'ctx, 'an, 'inp> {
                 default: None,
                 in_list: None,
                 location: self.location,
+                absolute: false,
             });
         }
 
         // `name` or `obj/name` or `var/obj/name` or ...
         let leading_loc = self.updated_location();
-        let (_absolute, mut path) = leading!(self.tree_path(true));
+        let (absolute, mut path) = leading!(self.tree_path(true));
         let name = match path.pop() {
             Some(name) => name,
             None => {
@@ -1399,6 +1400,7 @@ impl<'ctx, 'an, 'inp> Parser<'ctx, 'an, 'inp> {
             default,
             in_list,
             location,
+            absolute,
         })
     }
 
-- 
