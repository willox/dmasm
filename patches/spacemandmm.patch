From 7ea6fdd56476024db8ae2b48e7532c4767ce399f Mon Sep 17 00:00:00 2001
From: "Sophie Wallace (Cloub)" <sophie@wiox.me>
Date: Sun, 8 Nov 2026 14:58:27 +0000
Subject: [PATCH 10/13] Raw strings get the escapes a normal string's text has

Term::String holds a string as written, escapes and all. A raw string's
text was stored as is, so a backslash in @"..." read as an escape.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 crates/dreammaker/src/parser.rs | 15 +++++++++++++++
 1 file changed, 15 insertions(+)

diff --git a/crates/dreammaker/src/parser.rs b/crates/dreammaker/src/parser.rs
index 8db01b7..99d80e1 100644
--- a/crates/dreammaker/src/parser.rs
+++ b/crates/dreammaker/src/parser.rs
@@ -2636,6 +2636,9 @@ impl<'ctx, 'an, 'inp> Parser<'ctx, 'an, 'inp> {
             },
 
             // term :: str_lit | num_lit
+            // A raw string's text is written the way a normal string's is, with
+            // escapes, so the two mean the same: @"a\b" is "a\\b"
+            Token::String(val, crate::lexer::StringKind::Raw) => Term::String(escape_raw(&val).into()),
             Token::String(val, _) => Term::String(val),
             Token::Resource(val) => {
                 self.annotate_precise(start..start.add_columns(2 + val.len() as u16), || Annotation::Resource((*val).into()));
@@ -2953,3 +2956,15 @@ fn reconstruct_path(
     }
     result
 }
+
+/// Writes a raw string's text with the escapes a normal string would need.
+fn escape_raw(text: &str) -> String {
+    let mut out = String::with_capacity(text.len());
+    for ch in text.chars() {
+        if matches!(ch, '\\' | '"' | '[') {
+            out.push('\\');
+        }
+        out.push(ch);
+    }
+    out
+}
