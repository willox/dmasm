From 46e3bb708e7fb5c9ea97d134072c3069100e4444 Mon Sep 17 00:00:00 2001
From: "Sophie Wallace (Cloub)" <sophie@wiox.me>
Date: Sun, 8 Nov 2026 16:58:49 +0000
Subject: [PATCH 12/13] Preprocessor: #pragma takes the rest of its line
 (#pragma ignore unused_var left a stray token in the code)

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 crates/dreammaker/src/preprocessor.rs | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/crates/dreammaker/src/preprocessor.rs b/crates/dreammaker/src/preprocessor.rs
index 1668873..8ce0541 100644
--- a/crates/dreammaker/src/preprocessor.rs
+++ b/crates/dreammaker/src/preprocessor.rs
@@ -1074,6 +1074,13 @@ impl<'ctx> Preprocessor<'ctx> {
                             self.multiple_locations
                                 .insert(pragma_use_loc.file, pragma_use_loc);
                         }
+                        // The rest of the line (`#pragma ignore unused_var`) is
+                        // the pragma's, not code
+                        while let Some(lt) = self.inner_next() {
+                            if lt.token == Token!['\n'] {
+                                break;
+                            }
+                        }
                     },
                     // none of this other stuff should even exist
                     other => {
